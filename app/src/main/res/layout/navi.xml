<?xml version="1.0" encoding="utf-8"?>
<!--
  HUD 布局：全屏地图 + 两类控件，两套互斥显示（由 WanqiMapNaviActivity 的状态机切换）。

  ① 导航中（默认）    转弯指引（下方居中） + 返回按钮（左上）
  ② 浏览地图中        视角切换（左下） + 缩放胶囊（右下） + 返回按钮（左上）

  圆形表盘适配：所有位置都按圆方程验算过，不是拍脑袋定的。
  距顶端/底端 y 处的可用宽度 = 2·√(R² − (R−y)²)。
  面板按最小的 192dp 表（R=96）取值，227dp 表（R=113.5）更宽松：
    · 顶部/底部居中面板 maxWidth 112dp、边距 20dp  ⇒ 顶(底)角距圆心 ≤ 109dp < 113.5
  按钮三项按 227dp 表（R=113.5）算（可用上限即 R），见下方「按钮尺寸规则」。

  按钮尺寸规则（三处统一）：
    视图 48dp（含 5dp 内边距）= 手表的可点面积下限；
    可见圆/胶囊 38dp ⇒ 三个控件直径完全一致，也等于参考设计稿里按钮占表盘的比例。
    · 左上返回   可见圆 marginStart|Top 33dp ⇒ 圆上角距圆心 106.0dp
    · 左下切换   可见圆 marginStart 31dp、marginBottom 37dp ⇒ 104.7dp
    · 右下胶囊   可见条 marginEnd 31dp、marginBottom 37dp ⇒ 右下角 112.5dp
  三者都已贴近圆边（可用上限 113.5dp）：再往外，缩放胶囊的右下角会最先被圆边切到，
  它的几何上限是 3.7dp（左上返回还有 8.3dp、左下切换 9.2dp 余量）。
  注意：视图比可见图形大 5dp，所以 layout_margin 都按「目标位置 − 5dp」写。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.amap.api.navi.AMapNaviView
        android:id="@+id/naviView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 下方居中：转向指引（导航中）/ 状态提示（算路中、出错） -->
    <LinearLayout
        android:id="@+id/hud_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_hud_panel"
        android:gravity="center_horizontal"
        android:maxWidth="112dp"
        android:minWidth="100dp"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/text_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="3"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/turn_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.amap.api.navi.view.NextTurnTipView
                    android:id="@+id/nextTurnView"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />

                <!-- 下一路口距离：设计稿里最大的那个数字 -->
                <TextView
                    android:id="@+id/text_next_road_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 路名与剩余里程合成一行，把面板高度压到约 51dp -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_current_road"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#DDDDDD"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/text_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#9FB3C8"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 左上角：退出导航（两套状态下都显示）。深灰底 + 白色箭头，颜色刻意与其它按钮区分。
         视图 48dp / 可见圆 38dp，margin 28 = 目标 33 − 5(内边距)。 -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/hud_cd_back"
        android:padding="5dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 左下：切换总览 / 回到导航视角（仅「浏览地图中」显示）。半透明白底 + 深色图标。 -->
    <ImageButton
        android:id="@+id/btn_view_mode"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="26dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_round_button_light"
        android:contentDescription="@string/hud_cd_overview"
        android:padding="5dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_overview"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 右下：缩放胶囊（仅「浏览地图中」显示）。半透明白底 + 深色 +/−，与左下按钮同色同高。 -->
    <LinearLayout
        android:id="@+id/zoom_pill"
        android:layout_width="88dp"
        android:layout_height="48dp"
        android:layout_marginEnd="31dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_zoom_pill"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_zoom_in"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:contentDescription="@string/hud_cd_zoom_in"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_zoom_in" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="#1A000000" />

        <ImageButton
            android:id="@+id/btn_zoom_out"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:contentDescription="@string/hud_cd_zoom_out"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_zoom_out" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
