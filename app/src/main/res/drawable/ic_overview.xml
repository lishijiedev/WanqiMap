<?xml version="1.0" encoding="utf-8"?>
<!--
  左下角「总览」图标（导航中显示）：起点圆点 + 蜿蜒路线 + 向上箭头。
  即各家地图 App 通用的「路线全览」图标。

  比例按用户提供的参考截图逐像素量取后换算（视口 24x24）：
    · 三根竖线间距 1 : 2.3（轴心 3.63 / 11.25 / 19.76）
    · 上方折返半径 3.81，下方折返半径 4.25
    · 线宽 1.75，圆头；终点箭头宽 5.64、高 3.3；起点圆点直径 4.52
    · 字形占按钮直径约 62%（参考图实测值），故 intrinsic 定为 30dp（按钮 44dp）
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="26dp"
    android:height="26dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 路线：起点向上 → 折返向下 → 再折返向上 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M3.63,15.6 L3.63,5.35 A3.81,3.81 0 0 1 11.25,5.35 L11.25,18.23 A4.25,4.25 0 0 0 19.76,18.23 L19.76,4.01"
        android:strokeColor="#FF222222"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.75" />

    <!-- 终点箭头（朝上） -->
    <path
        android:fillColor="#FF222222"
        android:pathData="M19.76,0.75 L22.58,4.05 L16.94,4.05 Z" />

    <!-- 起点圆点 -->
    <path
        android:fillColor="#FF222222"
        android:pathData="M1.05,19.05 A2.26,2.26 0 1 0 5.57,19.05 A2.26,2.26 0 1 0 1.05,19.05 Z" />
</vector>
